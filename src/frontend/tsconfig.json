{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "outDir": "./deploy/dist/js",
    "rootDir": "./src/js",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "allowJs": true,
    "checkJs": false,
    "baseUrl": "./src/js",
    "paths": {
      "@/*": ["./*"]
    },
    "removeComments": true,
    "declaration": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "src/js/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}