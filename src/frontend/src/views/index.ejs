<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <title>Quote Generator</title>
    <!-- Add Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Add jsPDF library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.pl.autotable.min.js"></script>
    <!-- Add our custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <h1 class="text-center">Quote Generator</h1>
        <form id="invoiceForm">
            <!-- Step 1: Items Selection -->
            <div id="step1" class="form-step">
                <h3 class="section-heading mb-2">Please select product:</h3>
                <div class="relative inline-block mb-4">
                    <i class="fas fa-shopping-cart text-gray-600"></i>
                    <span class="cart-count absolute -top-2 -right-2 bg-green-500 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">0</span>
                </div>
                <div class="form-group">
                    <div id="itemsContainer" class="items-container">
                        <%- include('../js/components/item-selector/item-selector.ejs') %>
                    </div>
                </div>
            </div>

            <!-- Step 2: Customer Details -->
            <div id="step2" class="form-step hidden">
                <h3 class="section-heading">Please enter your details:</h3>
                <div id="customerDetailsContainer" class="form-group">
                    <%- include('../js/components/customer-details/customer-details.ejs') %>
                </div>
                <div class="button-group">
                    <button type="button" id="backBtn" class="btn-secondary">Back</button>
                    <button type="submit" id="generateInvoiceBtn" class="btn-primary">Generate Invoice</button>
                </div>
            </div>
        </form>
    </div>

    <footer class="footer">
        <img 
            id="companyLogo" 
            alt="Company Logo" 
            src="/images/company_logo.png"/>
    </footer>
    <!-- Add our custom JavaScript -->
    <script type="module" src="/js/script.js"></script>
</body>
</html> 