<!-- Delete Confirmation Modal -->
<dialog id="deleteConfirmModal" class="modal">
    <div class="modal-box">
        <h3 class="font-bold text-lg text-error">Delete Product</h3>
        <p class="py-4">Are you sure you want to delete "<span id="deleteProductName" class="font-bold"></span>"?</p>
        <p class="text-sm text-gray-500">This action cannot be undone.</p>
        <div class="modal-action">
            <button class="btn btn-error" id="confirmDeleteBtn">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                </svg>
                Delete
            </button>
            <button class="btn" id="cancelDeleteBtn">Cancel</button>
        </div>
    </div>
</dialog>

<!-- Product Editor Modal -->
<dialog id="productModal" class="modal">
    <div class="modal-box">
        <h3 class="font-bold text-lg" id="modalTitle">Add New Product</h3>
        <form id="productForm">
            <div class="form-control">
                <label class="label">
                    <span class="label-text">Name</span>
                </label>
                <input type="text" name="name" class="input input-bordered" required />
            </div>
            <div class="form-control">
                <div class="grid grid-cols-[1fr_120px_50px] gap-4">
                    <div>
                        <label class="label">
                            <span class="label-text">Size</span>
                        </label>
                    </div>
                    <div>
                        <label class="label">
                            <span class="label-text">Price</span>
                        </label>
                    </div>
                    <div></div>
                </div>
                <div id="sizesContainer" class="space-y-2">
                    <!-- Sizes will be added here dynamically -->
                </div>
                <div class="flex justify-end mt-2">
                    <button type="button" class="btn btn-primary" id="addSizeBtn" title="Add Size">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                    </button>
                </div>
            </div>
            <div class="form-control">
                <label class="label">
                    <span class="label-text">Options (comma-separated)</span>
                </label>
                <input type="text" name="options" class="input input-bordered" />
            </div>
            <div class="form-control">
                <label class="label">
                    <span class="label-text">Description</span>
                </label>
                <textarea name="description" class="textarea textarea-bordered"></textarea>
            </div>
            <div class="modal-action">
                <button type="submit" class="btn btn-primary" title="Save">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </button>
                <button type="button" class="btn" id="closeModalBtn" title="Cancel">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </form>
    </div>
</dialog>

<!-- Product List Template -->
<template id="productListTemplate">
    <tr>
        <td>
            <div class="flex justify-between items-center">
                <div>
                    <h3 class="font-bold">{{name}}</h3>
                    <p class="text-sm text-gray-500">{{description}}</p>
                    <div class="mt-2">
                        {{#sizes}}
                        <span class="badge badge-primary mr-2">
                            {{size}} - R{{price}}
                        </span>
                        {{/sizes}}
                    </div>
                </div>
                <div class="flex gap-2">
                    <button class="btn btn-ghost edit-product-btn" data-product-name="{{name}}" title="Edit">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                        </svg>
                    </button>
                    <button class="btn btn-ghost text-error delete-product-btn" data-product-name="{{name}}" title="Delete">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                        </svg>
                    </button>
                </div>
            </div>
        </td>
    </tr>
</template>

<!-- Empty State Template -->
<template id="emptyStateTemplate">
    <tr>
        <td class="text-center py-8">
            <div class="text-gray-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 mx-auto mb-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
                </svg>
                <p>No products available</p>
                <button class="btn btn-primary mt-4" id="addFirstProductBtn">Add Your First Product</button>
            </div>
        </td>
    </tr>
</template>

<!-- Error State Template -->
<template id="errorStateTemplate">
    <tr>
        <td class="text-center py-8">
            <div class="text-error">
                <p>Error loading products. Please try again later.</p>
            </div>
        </td>
    </tr>
</template>

<!-- Size Row Template -->
<template id="sizeRowTemplate">
    <div class="size-input grid grid-cols-[1fr_120px_50px] gap-4">
        <input type="text" name="size" class="input input-bordered" placeholder="Size" required />
        <input type="number" name="price" class="input input-bordered" placeholder="Price" required />
        <button type="button" class="btn btn-ghost remove-size-btn">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>
</template> 